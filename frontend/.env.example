# CloudGuard AI - Frontend Environment Configuration

# Enable complete local mock data mode (true = zero backend required, false = live API Gateway)
VITE_USE_MOCKS=true

# AWS API Gateway HTTP API Endpoint (when VITE_USE_MOCKS=false)
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# Amazon Cognito Authentication (optional when in mock mode)
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=us-east-1
