# ==============================================================================
# CloudGuard AI - Root Environment Configuration Template
# NOTE: Never store real AWS credentials here. Deploy using IAM roles / GitHub OIDC.
# ==============================================================================

# AWS Deployment Region
AWS_REGION=us-east-1
ENVIRONMENT=prod
PROJECT_NAME=cloudguard-ai

# Amazon Bedrock Foundation Model ID
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# CloudGuard Alerts & Weekly Email Digest Recipient
ALERT_EMAIL=cloud-security-lead@example.com

# Monthly AWS Cost Budget Limit (USD)
BUDGET_LIMIT_USD=200

# Frontend Configuration
VITE_USE_MOCKS=true
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
